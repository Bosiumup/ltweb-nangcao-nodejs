<style>
    .card.bg-primary {
        background: linear-gradient(
            90deg,
            #6fa3ef,
            #c1d8f7
        ); /* Màu xanh nhạt với gradient */
    }

    .card.bg-danger {
        background: linear-gradient(
            90deg,
            #f76c6c,
            #fdb8b8
        ); /* Màu đỏ nhạt với gradient */
    }

    .card.bg-success {
        background: linear-gradient(
            90deg,
            #68c47e,
            #a8e7b1
        ); /* Màu xanh lá nhạt */
    }

    .card.bg-warning {
        background: linear-gradient(
            90deg,
            #f7c837,
            #f7e3a4
        ); /* Màu vàng nhạt */
    }
</style>

<div class="container-fluid px-4">
    <h1 class="mt-4">Dashboard</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">
            Trang chi tiết thông tin tổng quan
        </li>
    </ol>
    <div class="row">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-dark mb-4">
                <div class="card-body">Người dùng (<%= data.totalUsers %>)</div>
                <div
                    class="card-footer d-flex align-items-center justify-content-between"
                >
                    <a
                        class="small text-dark stretched-link"
                        href="/Page_List_User"
                        >Xem chi tiết</a
                    >
                    <div class="small text-dark">
                        <i class="fas fa-angle-right"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-danger text-dark mb-4">
                <div class="card-body">
                    Sản phẩm (<%= data.totalProducts %>)
                </div>
                <div
                    class="card-footer d-flex align-items-center justify-content-between"
                >
                    <a
                        class="small text-dark stretched-link"
                        href="/Page_List_Product"
                        >Xem chi tiết</a
                    >
                    <div class="small text-dark">
                        <i class="fas fa-angle-right"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-dark mb-4">
                <div class="card-body">Đơn hàng (<%= data.totalOrders %>)</div>
                <div
                    class="card-footer d-flex align-items-center justify-content-between"
                >
                    <a
                        class="small text-dark stretched-link"
                        href="/Page_List_Order"
                        >Xem chi tiết</a
                    >
                    <div class="small text-dark">
                        <i class="fas fa-angle-right"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-dark mb-4">
                <div class="card-body">Bình luận (...)</div>
                <div
                    class="card-footer d-flex align-items-center justify-content-between"
                >
                    <a class="small text-dark stretched-link" href="#"
                        >Xem chi tiết</a
                    >
                    <div class="small text-dark">
                        <i class="fas fa-angle-right"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xl-12">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-area me-1"></i>
                    Biểu đồ tròn dữ liệu tổng quan
                </div>
                <div class="card-body">
                    <canvas id="myPieChart" width="100%" height="40"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Bảng dữ liệu người dùng gần đây
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-responsive table-borderless mb-0">
                    <thead>
                        <tr class="border-bottom">
                            <th scope="col" width="5%">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                />
                            </th>
                            <th scope="col">ID</th>
                            <th scope="col">Ảnh đại diện</th>
                            <th scope="col">Tài khoản</th>
                            <th scope="col">Họ tên</th>
                            <th scope="col">Địa chỉ</th>
                            <th scope="col">Số điện thoại</th>
                            <th scope="col">Vai trò</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% data.listUsers.forEach(user => { %>
                        <tr>
                            <th scope="row">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                />
                            </th>
                            <td><%= user.id %></td>
                            <td>
                                <img
                                    src="<%= user.imageUrl %>"
                                    alt=""
                                    style="
                                        width: 50px;
                                        height: 50px;
                                        border-radius: 50%;
                                    "
                                />
                            </td>
                            <td><%= user.username %></td>
                            <td><%= user.fullname %></td>
                            <td><%= user.address %></td>
                            <td><%= user.phone %></td>
                            <td><%= user.role %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Bảng dữ liệu sản phẩm gần đây
        </div>
        <div class="card-body"></div>
    </div>
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Bảng dữ liệu đơn hàng gần đây
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-responsive table-borderless mb-0">
                    <thead>
                        <tr class="border-bottom">
                            <th scope="col" width="5%">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                />
                            </th>
                            <th scope="col">ID</th>
                            <th scope="col">Địa chỉ</th>
                            <th scope="col">SĐT</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col">Id người dùng</th>
                            <th scope="col" class="text-center">
                                <span>Cài đặt</span>
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        <% data.listOrders.forEach(order=> { %>
                        <tr>
                            <th scope="row">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                />
                            </th>
                            <td><%= order.id %></td>

                            <td><%= order.address %></td>
                            <td><%= order.phone %></td>
                            <td><%= order.status %></td>
                            <td><%= order.id_user %></td>
                            <td
                                style="display: flex; gap: 10px"
                                class="d-flex align-items-center justify-content-center"
                            >
                                <a
                                    href="/PAGE_Detail_Order/<%=order.id%>"
                                    class="view"
                                >
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a href="/PAGE_Edit_Order/<%=order.id%>">
                                    <i class="fa-solid fa-gear"></i>
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Bảng dữ liệu bình luận gần đây
        </div>
        <div class="card-body"></div>
    </div>
</div>
