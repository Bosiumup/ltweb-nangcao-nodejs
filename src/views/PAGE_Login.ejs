<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Đăng nhập</title>
        <link rel="stylesheet" href="/css/auth.css" />
        <link rel="stylesheet" href="/css/noti.css" />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
        />
        <link href="/css/styles.css" rel="stylesheet" />
    </head>
    <body>
        <div class="wrapper">
            <div class="title"><span>Coolmate Admin</span></div>
            <form action="/login" method="POST">
                <div class="row">
                    <i class="fas fa-user"></i>
                    <input
                        name="username"
                        type="text"
                        placeholder="Tên tài khoản"
                        required
                    />
                </div>
                <div class="row">
                    <i class="fas fa-lock"></i>
                    <input
                        name="password"
                        type="password"
                        placeholder="Mật khẩu"
                        required
                    />
                </div>
                <div class="row button">
                    <input type="submit" value="Đăng nhập" />
                </div>
            </form>
            <a
                class="text-decoration-none text-center w-100 d-inline-block mb-3"
                href="/"
            >
                <i class="fas fa-arrow-left me-1"></i>
                Quay lại Dashboard
            </a>
        </div>
        <!-- Hiển thị thông báo -->
        <% if (data.successMessage && data.typeMessage) { %>
        <div
            id="message"
            class="text-center mt-3 alert message <%= data.typeMessage === 'success' ? 'alert-success' : 'alert-danger' %>"
        >
            <%= data.successMessage %>
        </div>
        <% } %>
        <script src="/js/noti.js"></script>
    </body>
</html>
