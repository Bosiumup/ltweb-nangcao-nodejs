                                    src="<%= product.imageUrl %>"
                                    alt=""
                                    style="
                                        width: 50px;
                                        height: 50px;
                                        border-radius: 50%;
                                    "
                                />
                            </td>
                            <td><%= product.name %></td>
                            <td><%= product.description %></td>
