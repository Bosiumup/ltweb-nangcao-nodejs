<style>
    .search-hover input.custom-hover:focus {
        box-shadow: 4px 4px 6px rgba(0, 0, 0, 0.808);
        transition: all 0.1s linear;
    }
    .form-control {
        border: none;
    }
    .form-control:focus {
        border: none;
    }
</style>

<div class="container-fluid px-4">
    <h1 class="mt-4">Danh sách sản phẩm</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Bảng chi tiết thông tin sản phẩm</li>
    </ol>
    <div class="card mb-4">
        <div class="card-header bg-white">
            <div class="my-2 d-flex justify-content-between align-items-center">
                <div class="position-relative search-hover w-100">
                    <form action="/PAGE_List_Product" method="get">
                        <span class="position-absolute search">
                            <i class="fa fa-search"></i>
                        </span>
                        <input
                            type="text"
                            name="search"  
                            class="form-control custom-hover"
                            placeholder="Nhập tên sản phẩm hoặc mô tả"
                            value="<%= data.search %>" 
                        />
                        <button type="submit" hidden></button>
                    </form>
                </div>
                <div class="px-2">
                    <span
                        id="filterToggle"
                        class="dropdown-toggle fw-normal"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    >
                        <% if (data.sortOrder === 'asc') { %> Sắp xếp từ A -> Z
                        <% } else if (data.sortOrder === 'desc') { %> Sắp xếp từ
                        Z -> A <% } else { %> Sắp xếp theo tên <% } %>

                        <!-- Menu Dropdown -->
                        <ul
                            id="filterMenu"
                            class="dropdown-menu shadow-lg rounded"
                        >
                            <li>
                                <!-- Sử dụng button thay vì a -->
                                <button type="button" class="dropdown-item" onclick="location.href='/PAGE_List_Product?page=<%= data.currentPage %>&sort=asc'">
                                    Từ A <i class="fa-solid fa-arrow-right"></i> Z
                                </button>
                            </li>
                            <li>
                                <!-- Sử dụng button thay vì a -->
                                <button type="button" class="dropdown-item" onclick="location.href='/PAGE_List_Product?page=<%= data.currentPage %>&sort=desc'">
                                    Từ Z <i class="fa-solid fa-arrow-right"></i> A
                                </button>
                            </li>
                        </ul>
                    </span>
                </div>
            </div>
        </div>
        <div class="card-body bg-light">
            <div class="table-responsive">
                <table class="table table-responsive table-borderless mb-0">
                    <thead>
                        <tr class="border-bottom">
                            <th scope="col" width="5%">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                />
                            </th>
                            <th scope="col">ID loại sản phẩm</th>
                            <th scope="col">ID</th>
                            <th scope="col">Hình ảnh</th>
                            <th scope="col">Tên sản phẩm</th>
                            <th scope="col">Mô tả</th>
